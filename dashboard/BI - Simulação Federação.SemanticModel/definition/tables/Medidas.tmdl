	measure '6.09 Cargos Conflito' =
			
			SWITCH(
			    TRUE(),
			    [6.08 Conflito Partidos com Mandatário Estratégico]==1, "Deputado Estadual",
			    [6.08 Conflito Partidos com Mandatário Estratégico]==2, "Deputado Federal",
			    [6.08 Conflito Partidos com Mandatário Estratégico]==3, "Dep. Federal e Dep. Estadual",
			    "Estado sem Conflito")
		lineageTag: 9ddd4b06-6d75-46d8-a3ac-8d9455cf1d5e

	measure '6.10 Mandatário Atual' =
			CALCULATE(
			    DISTINCTCOUNT(f_mdt_mandatarios_atuais[sq_candidato]),
			    f_mdt_mandatarios_atuais[sq_candidato]=SELECTEDVALUE(f_historico_eleicoes[sq_candidato])
			    )
		formatString: 0
		lineageTag: b8579066-efbc-4835-b20a-56b9f0e1a281

	measure 'Candidatos na Cidade' =
			
			VAR CidadeAtual = SELECTEDVALUE(f_historico_eleicoes[cod_tse])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT( f_historico_eleicoes[sq_candidato] ),
			    ALLSELECTED( f_historico_eleicoes ),           // ignora filtros do visual (cod_tse, nr_turno, nm_urna_candidato…)
			    f_historico_eleicoes[cod_tse] = CidadeAtual   // reaplica o filtro apenas por município
			)
		formatString: 0
		lineageTag: 3f8afa59-967a-400d-8a3c-a0aae44d4d1b

	measure 'Emoji Mouse' = "🔍"
		lineageTag: 2521165b-f654-4bd6-93dd-b4caf92f8c37

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

