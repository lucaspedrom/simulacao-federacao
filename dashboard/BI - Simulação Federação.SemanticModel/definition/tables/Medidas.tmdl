	measure '6.08 Conflito Partidos com Mandatário Estratégico' =
			
			var f = COALESCE(
			        CALCULATE(
			            DISTINCTCOUNT(f_mdt_mandatarios_atuais[partido_atual]),
			            f_mdt_mandatarios_atuais[cargo]="DEPUTADO FEDERAL"),
			        0
			    )
			var e = COALESCE(
			        CALCULATE(
			            DISTINCTCOUNT(f_mdt_mandatarios_atuais[partido_atual]),
			            f_mdt_mandatarios_atuais[cargo]="DEPUTADO ESTADUAL"),
			        0
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    f>1 && e>1, 3,
			    f>1,2,
			    e>1,1,
			    0)
