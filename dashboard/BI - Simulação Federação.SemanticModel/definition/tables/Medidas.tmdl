	measure '8.04 Cobertura Eleitoral Simulacao Gráfico' = ```
			
			VAR PartidosSelecionados = VALUES(d_partidos[partido])
			VAR PartidoAtual = SELECTEDVALUE(s_partidos_federacao[partido])
			RETURN
			IF(
			    PartidoAtual = "SIMULAÇÃO",
			    CALCULATE(
			        [8.04 Cobertura Eleitoral],
			        d_partidos[partido] IN PartidosSelecionados
			    ),
			    IF(
