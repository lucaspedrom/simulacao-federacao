	measure '5.05 Qtd de Partidos/Fed. Formados 2026' =
			
			var t = CALCULATE(COUNT(d_partidos[partido]),REMOVEFILTERS(d_partidos))
			var x = COUNT(d_partidos[partido])
			RETURN
			t-x+1
		formatString: 0
		displayFolder: 5. Análises Estaduais
		lineageTag: 8edefce0-5ff0-42c4-8834-b5e9cd02f314

	measure '5.04 % Qtd. Deputados Federais Eleitos' =
			
			var t = CALCULATE(DISTINCTCOUNT(f_candidatos_2022[sq_candidato]),f_candidatos_2022[cd_cargo]=6,f_candidatos_2022[cd_sit_tot_turno]IN{1,2,3},REMOVEFILTERS(d_partidos),REMOVEFILTERS(d_estado))
			RETURN
			DIVIDE([5.03  Qtd. Deputados Federais Eleitos 2022],t,0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 5. Análises Estaduais
		lineageTag: 6084ea57-a45b-4ae6-82fd-1183733c9da2

	measure '5.06 % Tempo de TV e Rádio' =
			
			var d = DIVIDE(0.1,[5.05 Qtd de Partidos/Fed. Formados 2026])
			var n = 0.9*[5.04 % Qtd. Deputados Federais Eleitos]
			RETURN
			IF(OR(AND([5.00 % Votos Deputados Federais Candidatos s/filtro UF]>=0.02,[5.02 Qtd. Estados com mais de 1% de Votos]>=9),AND([5.03  Qtd. Deputados Federais Eleitos 2022]>=11,[5.01 Qtd. UF com Deputados Eleitos]>=9)),D+n,0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 5. Análises Estaduais
		lineageTag: 5519b219-a4d9-4488-950d-d5d93fc7d9e0

