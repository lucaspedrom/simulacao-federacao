	measure '9.08 Votos Chapa' = ```
			
			VAR CargoDesejado = [9.09 cargo_selecionado]
			VAR VagasDisponiveis = 
			    SWITCH(
			      CargoDesejado,
			      "Deputado Estadual",   MAX(d_estado[vagas_dep_est]),
			      "Deputado Distrital",  MAX(d_estado[vagas_dep_est]),
			      "Deputado Federal",    MAX(d_estado[vagas_dep_fed]),
			      "Vereador",            MAX(d_local_municipio[vagas_vereador]),
			      "Prefeito",            0
			    ) + 1
			
			VAR AnoSel = [9.10 ultimo_ano]
			
			// 1) Filtro base: cargo + ano (mantém filtros de município/estado via ALLSELECTED)
			VAR FiltroBase =
			    FILTER(
			      ALLSELECTED(f_historico_eleicoes),
			      f_historico_eleicoes[ds_cargo]   = CargoDesejado &&
			      f_historico_eleicoes[aa_eleicao] = AnoSel
			    )
			
			// 2) Agrupa por candidato, somando todos os votos (por município ou global conforme filtros externos)
			VAR TabelaAgrupada =
			    SUMMARIZE(
			      FiltroBase,
			      f_historico_eleicoes[sq_candidato],
			      f_historico_eleicoes[nm_urna_candidato],
			      "TotalVotos", SUM(f_historico_eleicoes[qt_votos_nom_validos])
			    )
			
			// 3) Adiciona ranking sobre o TotalVotos
			VAR TabelaComRank =
			    ADDCOLUMNS(
			      TabelaAgrupada,
			      "RankingVotos",
			      RANKX(
			        TabelaAgrupada,
			        [TotalVotos],
			        ,
			        DESC,
			        Skip   // empata coloca no mesmo ranking
			      )
			    )
			
			// 4) Filtra os top X candidatos
			VAR TopCandidatos =
			    FILTER(
			      TabelaComRank,
			      [RankingVotos] <= VagasDisponiveis
			    )
			
			// 5) Soma os votos desses top candidatos
			RETURN
			    SUMX( TopCandidatos, [TotalVotos] )
			```
		formatString: 0
		displayFolder: 9. Histórico Eleições
		lineageTag: c6214834-9bff-47d1-9e87-b51f0152c87c

	measure '9.11 Filtrar Cargos Historico Eleicao' = ```
			
			VAR MunicipiosSelecionados = DISTINCTCOUNT(d_local_municipio[cod_tse])
