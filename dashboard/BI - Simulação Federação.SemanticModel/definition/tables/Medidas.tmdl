		displayFolder: 5. Análises Estaduais
		lineageTag: dc455fb1-1a05-49b3-8348-a22b8ec22741

	measure '3.04 TempoPropaganda' =
			
			var TotalTempoDisponivel = 1500
			VAR Percentual = [5.06 % Tempo de TV e Rádio]
			VAR TempoEmSegundos = Percentual * TotalTempoDisponivel
			VAR Minutos = INT(TempoEmSegundos / 60)
			VAR Segundos = ROUND(MOD(TempoEmSegundos, 60),0)
			RETURN
			Minutos & "m" & Segundos & "s"
		displayFolder: 3. Recursos
		lineageTag: 01a1b130-4071-4f2c-9e4b-55f574b6edd8

