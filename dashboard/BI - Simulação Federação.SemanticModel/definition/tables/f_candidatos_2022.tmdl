	column mandatario_atual =
			
			var r = CALCULATE(DISTINCTCOUNT(f_mdt_mandatarios_atuais[sq_candidato]),FILTER(f_mdt_mandatarios_atuais,f_mdt_mandatarios_atuais[sq_candidato]=f_candidatos_2022[sq_candidato]))
			VAR C = CALCULATE(SELECTEDVALUE(f_mdt_mandatarios_atuais[cargo]),FILTER(f_mdt_mandatarios_atuais,f_mdt_mandatarios_atuais[sq_candidato]=f_candidatos_2022[sq_candidato]))
			var p = CALCULATE(SELECTEDVALUE(f_mdt_mandatarios_atuais[partido_atual]),FILTER(f_mdt_mandatarios_atuais,f_mdt_mandatarios_atuais[sq_candidato]=f_candidatos_2022[sq_candidato]))
			RETURN
			IF(r>0,C&"("&P&")","-")
		lineageTag: d2deea17-90b2-47ac-9f86-5dd5b46d8c45
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column genero_emoji =
			
			SWITCH(
			    TRUE(),
			    f_candidatos_2022[cd_genero] = 4, "🚺",
			    f_candidatos_2022[cd_genero] = 2, "🚹",
			    "-")
		lineageTag: 7e945adc-7708-45ca-9e85-a633a78b9b2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column resultado_eleito =
			
			SWITCH(
			    TRUE(),
			    f_candidatos_2022[sit_tot_turno.ds_sit_tot_turno] = "NÃO ELEITO", "NÃO ELEITO",
			    f_candidatos_2022[sit_tot_turno.ds_sit_tot_turno] = "SUPLENTE", "SUPLENTE",
			    CONTAINSSTRING(f_candidatos_2022[sit_tot_turno.ds_sit_tot_turno],"ELEITO"), "ELEITO",
			    f_candidatos_2022[sit_tot_turno.ds_sit_tot_turno])
		lineageTag: 4cf47adb-810c-45b7-84ef-412772eb1deb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition f_candidatos_2022 = m
		mode: import
		source =
				let
				    CaminhoBase = if Text.EndsWith(CaminhoDados, "\") or Text.EndsWith(CaminhoDados, "/") then CaminhoDados else CaminhoDados & "\",
				
				    CaminhoArquivo = CaminhoBase & "f_candidatos_2022.parquet",
				
				    Fonte = Parquet.Document(File.Contents(CaminhoArquivo)),
				    #"Colunas Calculadas Removidas" = Table.RemoveColumns(Fonte, {"mandatario_atual", "genero_emoji", "resultado_eleito"}, MissingField.Ignore)
				in
				    #"Colunas Calculadas Removidas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

