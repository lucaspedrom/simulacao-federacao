	column cod_faixa_populacional =
			SWITCH(
			  TRUE(),
			  d_local_municipio[populacao] <= 10000, 1,
			  d_local_municipio[populacao] <= 50000, 2,
			  d_local_municipio[populacao] <= 100000, 3,
			  d_local_municipio[populacao] <= 500000, 4,
			  5
			)
		formatString: 0
		lineageTag: f1e2cb41-a59d-4f76-9b00-7787de8d3b8c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition d_local_municipio = m
		mode: import
		source =
				let
				    CaminhoBase = if Text.EndsWith(CaminhoDados, "\") or Text.EndsWith(CaminhoDados, "/") then CaminhoDados else CaminhoDados & "\",
				
				    CaminhoArquivo = CaminhoBase & "d_local_municipio.parquet",
				
				    Fonte = Parquet.Document(File.Contents(CaminhoArquivo)),
				    #"Colunas Calculadas Removidas" = Table.RemoveColumns(Fonte, {"cod_faixa_populacional"}, MissingField.Ignore)
				in
				    #"Colunas Calculadas Removidas"

	annotation PBI_NavigationStepName = Navegação

