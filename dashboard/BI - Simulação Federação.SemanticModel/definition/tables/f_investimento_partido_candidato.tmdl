	column PARTIDO_CANDIDATO = ```
			
			CALCULATE(
			    SELECTEDVALUE(f_historico_eleicoes[sg_partido]),
			    FILTER(
			        f_historico_eleicoes,
			        FORMAT(f_historico_eleicoes[sq_candidato], "0") = FORMAT(f_investimento_partido_candidato[SQ_CANDIDATO], "0")
			        && f_historico_eleicoes[aa_eleicao] = f_investimento_partido_candidato[ANO_ELEICAO]
			    )
			)
			
			```
		lineageTag: 52ac1f62-f047-4cfb-8480-f33a85f7601a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column COD_TSE_CANDIDATO =
			
