	partition f_historico_eleicoes = m
		mode: import
		source =
				let
				    CaminhoBase = if Text.EndsWith(CaminhoDados, "\") or Text.EndsWith(CaminhoDados, "/") then CaminhoDados else CaminhoDados & "\",
				
				    CaminhoArquivo = CaminhoBase & "f_historico_eleicoes.parquet",
				
				    Fonte = Parquet.Document(File.Contents(CaminhoArquivo)),
				    #"Colunas Calculadas Removidas" = Table.RemoveColumns(Fonte, {"ordem_cargo"}, MissingField.Ignore)
				in
				    #"Colunas Calculadas Removidas"

